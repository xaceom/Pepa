{
  "name": "obsidian-telegram-emoji",
  "version": "0.1.0",
  "description": "Insert animated Telegram emoji in Obsidian notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "echo \"Error: no test command specified\" && exit 1",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "obsidian",
    "telegram",
    "emoji",
    "plugin",
    "animated",
    "stickers"
  ],
  "author": "Your Name",
  "license": "MIT",
  "peerDependencies": {
    "obsidian": "latest"
  },
  "dependencies": {
    "lottie-web": "^5.12.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "obsidian": "latest",
    "typescript": "^5.3.3"
  }
}
